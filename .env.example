# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://family:family@localhost:5434/family_finances
# Only for plain-HTTP development (e.g. opening Vite from a phone on the LAN). Never in production.
# SESSION_COOKIE_SECURE=false
# Public URL of the frontend, used in invitation links printed by `python -m app.invitations`.
# APP_URL=http://localhost:5173

# Production only. The app refuses to start in production with unsafe values.
# ENVIRONMENT=production
# ALLOWED_HOSTS=["finanzas.example.com"]
# Built frontend (frontend/dist) for the API to serve at /. In development leave it unset: Vite serves it.
# FRONTEND_DIST=/app/frontend/dist
