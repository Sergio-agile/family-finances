          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "List Categories",
        "operationId": "list_categories",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryRead"
                  },
                  "type": "array",
                  "title": "Response List Categories"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read"
            ]
          }
        ]
      }
    },
    "/api/households/{household_id}/expenses": {
      "get": {
        "tags": [
          "expenses"
        ],
        "summary": "List Expenses",
        "description": "The household's expenses of one month (YYYY-MM), newest first.",
        "operationId": "list_expenses",
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "2026-10"
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpenseRead"
                  },
                  "title": "Response List Expenses"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "expenses"
        ],
        "summary": "Create Expense",
        "operationId": "create_expense",
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read",
              "expenses:write"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read",
              "expenses:write"
            ]
          }
        ],
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{household_id}/expenses/{expense_id}": {
      "patch": {
        "tags": [
          "expenses"
        ],
        "summary": "Update Expense",
        "operationId": "update_expense",
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read",
              "expenses:write"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read",
              "expenses:write"
            ]
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expense Id"
            }
          },
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "expenses"
        ],
        "summary": "Delete Expense",
        "description": "Delete an expense for good: there is no trash to restore it from.",
        "operationId": "delete_expense",
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read",
              "expenses:write"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read",
              "expenses:write"
            ]
          }
        ],
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expense Id"
            }
          },
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{household_id}/members": {
      "get": {
        "tags": [
          "households"
        ],
        "summary": "List Members",
        "description": "The household's members, by name. Small by nature (a family), so not paginated.",
        "operationId": "list_members",
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read"
            ]
          },
