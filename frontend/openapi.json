            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberRead"
                  },
                  "title": "Response List Members"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/spending-types": {
      "get": {
        "tags": [
          "spending types"
        ],
        "summary": "List Spending Types",
        "description": "In seed order, which goes from essential to optional spending, not alphabetically.",
        "operationId": "list_spending_types",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SpendingTypeRead"
                  },
                  "type": "array",
                  "title": "Response List Spending Types"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": [
              "expenses:read"
            ]
          },
          {
            "HTTPBearer": [
              "expenses:read"
            ]
          }
        ]
      }
    },
    "/api/tokens": {
      "get": {
        "tags": [
          "api tokens"
        ],
        "summary": "List Api Tokens",
        "description": "Your API tokens, newest first. The tokens themselves are never shown again.",
        "operationId": "list_api_tokens",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApiTokenRead"
                  },
                  "type": "array",
                  "title": "Response List Api Tokens"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "api tokens"
        ],
        "summary": "Create Api Token",
        "description": "A new token acting as you, limited to its scopes. The response is the only time the token\nis shown: only its hash is stored.",
        "operationId": "create_api_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiTokenCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiTokenCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/tokens/{token_id}": {
      "delete": {
        "tags": [
          "api tokens"
        ],
        "summary": "Revoke Api Token",
        "description": "Revoke one of your tokens: it stops working at once.",
        "operationId": "revoke_api_token",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Token Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{household_id}/invitations": {
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Invite To Household",
        "description": "A one-time sign-up link that joins this household. Any member can create one.",
        "operationId": "invite_to_household",
        "security": [
          {
            "APIKeyCookie": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "household_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Household Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiTokenCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "n8n bank import"
            ]
          },
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "expenses:read",
                "expenses:write"
              ]
            },
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "title": "Scopes",
            "examples": [
              [
                "expenses:write"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "scopes"
        ],
        "title": "ApiTokenCreate"
      },
      "ApiTokenCreated": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "expenses:read",
                "expenses:write"
              ]
            },
            "type": "array",
            "title": "Scopes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Shown only now: store it, it cannot be retrieved again"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "scopes",
          "created_at",
          "last_used_at",
          "token"
        ],
        "title": "ApiTokenCreated"
      },
      "ApiTokenRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "expenses:read",
                "expenses:write"
              ]
            },
            "type": "array",
            "title": "Scopes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "scopes",
          "created_at",
          "last_used_at"
        ],
        "title": "ApiTokenRead"
      },
      "CategoryRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CategoryRead"
      },
      "ExpenseCreate": {
        "properties": {
          "amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents",
            "description": "Amount in cents: 12.50 € is 1250"
          },
          "concept": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Concept"
          },
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          },
          "spending_type_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spending Type Id"
          },
          "paid_by_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid By Id",
            "description": "The member who paid; null: not assigned yet"
          },
          "spent_on": {
            "type": "string",
            "format": "date",
            "title": "Spent On"
          }
        },
        "type": "object",
        "required": [
          "amount_cents",
          "concept",
          "category_id"
        ],
        "title": "ExpenseCreate"
      },
      "ExpenseRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "amount_cents": {
            "type": "integer",
            "title": "Amount Cents"
          },
          "concept": {
            "type": "string",
            "title": "Concept"
          },
          "spent_on": {
            "type": "string",
            "format": "date",
            "title": "Spent On"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryRead"
          },
          "spending_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpendingTypeRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "paid_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemberRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_by": {
            "$ref": "#/components/schemas/MemberRead"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount_cents",
          "concept",
          "spent_on",
          "category",
          "spending_type",
          "paid_by",
          "created_by",
          "created_at"
        ],
        "title": "ExpenseRead"
      },
      "ExpenseUpdate": {
        "properties": {
          "amount_cents": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Cents"
          },
          "concept": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept"
          },
          "category_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Id"
          },
          "spending_type_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spending Type Id"
          },
          "paid_by_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid By Id"
          },
          "spent_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spent On"
          }
        },
        "type": "object",
        "title": "ExpenseUpdate",
        "description": "Partial update: only the fields sent are changed. `null` unassigns the optional\n`spending_type_id` and `paid_by_id`."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
